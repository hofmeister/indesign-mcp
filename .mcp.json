{
  "mcpServers": {
    "indesign": {
      "command": "bun",
      "args": ["${CLAUDE_PLUGIN_ROOT}/src/cli.ts"],
      "env": {
        "OPENAI_API_KEY": "${user_config.openai_api_key}",
        "INDESIGN_MCP_DOCUMENTS": "${user_config.documents_dir}",
        "INDESIGN_MCP_REFERENCES": "${user_config.references_dir}",
        "INDESIGN_MCP_DEFAULT_UNIT": "${user_config.default_unit}",
        "INDESIGN_MCP_IMAGE_MODEL": "${user_config.image_model}"
      }
    }
  }
}
